# Generated / build output — never commit
build/
dist/
www/
node_modules/
.godot/
__pycache__/

# Audio .import files are all default settings (loop=false, bpm=0); Godot
# regenerates them on --import. Art .import files stay tracked.
godot/hula/audio/**/*.import

# Blender backups and local temp files
*.blend1
*.tmp
*.log

# Piper voice models: 60-120 MB binaries, downloaded per machine
tools/models/


# Piper speech cache (word/line renders reused across calls)
tools/.cache/

# Embedded Piper build: the Android Gradle output and the voice model are never committed
android/build/
android/piper/src/main/assets/*.onnx
android/piper/src/main/assets/*.onnx.json
.gradle/
.claude/.session_version
.claude/.agent
