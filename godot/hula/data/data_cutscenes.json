    "c_showdown": {
      "THE BREAKING": [
        {
          "who": "hero",
          "say": "Nobody asked how I was. Not once. Thirty fiestas, and they asked for the hat.",
          "mood": "plead",
          "gap": 75,
          "x": 235,
          "y": 92,
          "tx": 235,
          "ex": "disappointed",
          "heat": 0.2
        },
        {
          "who": "hero",
          "say": "I held this village together. Every lantern. Every guitar string. Me.",
          "mood": "cold",
          "gap": 60,
          "x": 235,
          "y": 92,
          "tx": 235,
          "ex": "indignant",
          "heat": 0.55
        },
        {
          "who": "hero",
          "say": "...Sorry. Sorry. I am fine. I am smiling. See?",
          "mood": "plead",
          "gap": 40,
          "x": 235,
          "y": 92,
          "tx": 235,
          "ex": "grin",
          "heat": 0.15
        },
        {
          "who": "kid",
          "say": "The hat was the hero. You were just the head underneath it.",
          "mood": "cold",
          "gap": 85,
          "x": 112,
          "y": 150,
          "tx": 56
        },
        {
          "who": "hero",
          "say": "Heh. Heh. Good one.",
          "mood": "stoned",
          "gap": 45,
          "x": 235,
          "y": 92,
          "tx": 235,
          "ex": "sarcastic",
          "heat": 0.35
        },
        {
          "who": "kid",
          "say": "Thirty fiestas, and nobody ever learned your name. Not even me.",
          "mood": "cold",
          "gap": 55,
          "x": 112,
          "y": 150,
          "tx": 56
        },
        {
          "who": "hero",
          "say": "...They know my name.",
          "mood": "cold",
          "gap": 45,
          "x": 235,
          "y": 92,
          "tx": 235,
          "ex": "defiant",
          "heat": 0.6
        },
        {
          "who": "kid",
          "say": "Then say it. Say your name.",
          "mood": "cold",
          "gap": 40,
          "x": 112,
          "y": 150,
          "tx": 56
        },
        {
          "who": "hero",
          "say": "It is... it is...",
          "mood": "plead",
          "gap": 50,
          "x": 235,
          "y": 92,
          "tx": 235,
          "ex": "bewildered",
          "heat": 0.5
        },
        {
          "who": "kid",
          "say": "You do not remember it, do you? Not even your own name.",
          "mood": "cold",
          "gap": 45,
          "x": 112,
          "y": 150,
          "tx": 56
        },
        {
          "who": "hero",
          "say": "I am the HERO!",
          "mood": "rageh",
          "gap": 30,
          "x": 235,
          "y": 92,
          "tx": 235,
          "ex": "rage",
          "heat": 0.85
